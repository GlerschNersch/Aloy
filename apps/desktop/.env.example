# Copy this file to .env and fill in your own value.
VITE_HA_TOKEN=your-home-assistant-long-lived-token

# Where Home Assistant lives (defaults to http://localhost:8123 if unset,
# which is almost never right — HA is typically a separate box on the LAN).
# https:// with a self-signed cert is fine — see getInsecureLanDispatcher in
# server/http.cjs.
HA_URL=https://homeassistant.local:8123
