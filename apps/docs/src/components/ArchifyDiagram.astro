---
// Archify-inspired Interactive Architecture Diagram Component for Aloy Docs
interface Props {
  title?: string;
  activeNode?: string;
}

const { title = "Aloy Unified Ecosystem Topology" } = Astro.props;
---

<div class="archify-container">
  <div class="archify-header">
    <div class="archify-title-wrap">
      <span class="archify-badge">LIVE TOPOLOGY</span>
      <h3 class="archify-title">{title}</h3>
    </div>
    <div class="archify-status">
      <span class="pulse-dot"></span>
      <span>Autonomous Nervous System Active</span>
    </div>
  </div>

  <div class="archify-stage">
    <!-- SVG Animated Node Connectors -->
    <svg class="archify-svg-lines" viewBox="0 0 800 360" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M 160 80 C 260 80, 260 180, 400 180" stroke="url(#lineGrad1)" stroke-width="2" stroke-dasharray="4 4" class="animated-path"/>
      <path d="M 160 280 C 260 280, 260 180, 400 180" stroke="url(#lineGrad1)" stroke-width="2" stroke-dasharray="4 4" class="animated-path"/>
      <path d="M 400 180 C 540 180, 540 80, 640 80" stroke="url(#lineGrad2)" stroke-width="2" stroke-dasharray="4 4" class="animated-path"/>
      <path d="M 400 180 C 540 180, 540 180, 640 180" stroke="url(#lineGrad2)" stroke-width="2" stroke-dasharray="4 4" class="animated-path"/>
      <path d="M 400 180 C 540 180, 540 280, 640 280" stroke="url(#lineGrad2)" stroke-width="2" stroke-dasharray="4 4" class="animated-path"/>
      
      <defs>
        <linearGradient id="lineGrad1" x1="0%" y1="0%" x2="100%" y2="0%">
          <stop offset="0%" stop-color="#00f2fe"/>
          <stop offset="100%" stop-color="#4facfe"/>
        </linearGradient>
        <linearGradient id="lineGrad2" x1="0%" y1="0%" x2="100%" y2="0%">
          <stop offset="0%" stop-color="#4facfe"/>
          <stop offset="100%" stop-color="#a855f7"/>
        </linearGradient>
      </defs>
    </svg>

    <!-- Node Columns -->
    <div class="archify-grid">
      <!-- Column 1: Clients -->
      <div class="archify-col">
        <div class="archify-node client-node">
          <div class="node-icon">💻</div>
          <div class="node-info">
            <strong>Desktop Client</strong>
            <span>Electron / React</span>
          </div>
        </div>
        <div class="archify-node client-node">
          <div class="node-icon">📱</div>
          <div class="node-info">
            <strong>Mobile Client</strong>
            <span>React Native (OnePlus)</span>
          </div>
        </div>
      </div>

      <!-- Column 2: Central Server & Model Router -->
      <div class="archify-col center-col">
        <div class="archify-node core-node">
          <div class="node-header">
            <span class="node-badge">NERVOUS SYSTEM</span>
          </div>
          <div class="node-icon-large">⚡</div>
          <strong>Aloy Server (Node/Express)</strong>
          <p>Port 7890 • Model Router • Token Compressor</p>
          <div class="model-tags">
            <span class="tag">Ollama GPU</span>
            <span class="tag">Claude API</span>
            <span class="tag">Needle Intent</span>
          </div>
        </div>
      </div>

      <!-- Column 3: Engines & Destinations -->
      <div class="archify-col">
        <div class="archify-node engine-node pantheon">
          <div class="node-icon">🏛️</div>
          <div class="node-info">
            <strong>The Pantheon Hub</strong>
            <span>Hermes, Heph, Athena, Apollo</span>
          </div>
        </div>
        <div class="archify-node engine-node smarthome">
          <div class="node-icon">🛡️</div>
          <div class="node-info">
            <strong>Minerva Sentinel</strong>
            <span>Home Assistant & Vision</span>
          </div>
        </div>
        <div class="archify-node engine-node media">
          <div class="node-icon">📺</div>
          <div class="node-info">
            <strong>Media Dispatcher</strong>
            <span>Roku, Jellyfin, Bazzite</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
.archify-container {
  background: #0f172a;
  border: 1px solid rgba(56, 189, 248, 0.25);
  border-radius: 16px;
  padding: 1.5rem;
  margin: 2rem 0;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
  font-family: 'Google Sans', sans-serif;
  overflow: hidden;
  position: relative;
}

.archify-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 1.5rem;
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  padding-bottom: 0.75rem;
}

.archify-badge {
  font-size: 0.65rem;
  font-weight: 800;
  color: #00f2fe;
  background: rgba(0, 242, 254, 0.15);
  padding: 2px 8px;
  border-radius: 4px;
  letter-spacing: 0.08em;
}

.archify-title {
  margin: 0.3rem 0 0 0 !important;
  font-size: 1.2rem !important;
  color: #f8fafc !important;
  border: none !important;
}

.archify-status {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 0.75rem;
  color: #38bdf8;
  font-weight: 600;
}

.pulse-dot {
  width: 8px;
  height: 8px;
  background: #38bdf8;
  border-radius: 50%;
  box-shadow: 0 0 10px #38bdf8;
  animation: pulse 2s infinite ease-in-out;
}

@keyframes pulse {
  0% { transform: scale(0.95); opacity: 0.6; }
  50% { transform: scale(1.3); opacity: 1; box-shadow: 0 0 15px #00f2fe; }
  100% { transform: scale(0.95); opacity: 0.6; }
}

.archify-stage {
  position: relative;
  min-height: 320px;
}

.archify-svg-lines {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
}

.animated-path {
  animation: dash 20s linear infinite;
}

@keyframes dash {
  to {
    stroke-dashoffset: -1000;
  }
}

.archify-grid {
  display: grid;
  grid-template-columns: 1fr 1.3fr 1fr;
  gap: 1.5rem;
  position: relative;
  z-index: 2;
  align-items: center;
}

.archify-col {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.archify-node {
  background: rgba(30, 41, 59, 0.85);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 12px;
  padding: 0.85rem 1rem;
  backdrop-filter: blur(8px);
  transition: all 0.2s ease;
  cursor: pointer;
}

.archify-node:hover {
  transform: translateY(-2px);
  border-color: #00f2fe;
  box-shadow: 0 0 15px rgba(0, 242, 254, 0.25);
}

.client-node {
  display: flex;
  align-items: center;
  gap: 12px;
}

.node-icon {
  font-size: 1.4rem;
}

.node-info strong {
  display: block;
  font-size: 0.88rem;
  color: #f8fafc;
}

.node-info span {
  font-size: 0.72rem;
  color: #94a3b8;
}

.center-col {
  text-align: center;
}

.core-node {
  padding: 1.25rem 1rem;
  background: radial-gradient(circle at center, rgba(14, 165, 233, 0.15) 0%, rgba(15, 23, 42, 0.9) 100%);
  border: 1px solid rgba(14, 165, 233, 0.4);
  box-shadow: 0 0 25px rgba(14, 165, 233, 0.2);
}

.node-badge {
  font-size: 0.6rem;
  font-weight: 800;
  color: #38bdf8;
  letter-spacing: 0.1em;
}

.node-icon-large {
  font-size: 2.2rem;
  margin: 0.4rem 0;
  filter: drop-shadow(0 0 12px #38bdf8);
}

.core-node strong {
  display: block;
  font-size: 1rem;
  color: #f8fafc;
}

.core-node p {
  font-size: 0.74rem;
  color: #94a3b8;
  margin: 0.3rem 0 0.8rem 0;
}

.model-tags {
  display: flex;
  justify-content: center;
  gap: 6px;
  flex-wrap: wrap;
}

.tag {
  font-size: 0.62rem;
  font-weight: 700;
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid rgba(255, 255, 255, 0.12);
  padding: 2px 6px;
  border-radius: 4px;
  color: #cbd5e1;
}

.engine-node {
  display: flex;
  align-items: center;
  gap: 12px;
}

@media (max-width: 768px) {
  .archify-grid {
    grid-template-columns: 1fr;
  }
  .archify-svg-lines {
    display: none;
  }
}
</style>
